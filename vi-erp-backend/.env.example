# Base de datos (Railway proporcionará DATABASE_URL automáticamente)
DATABASE_URL="postgresql://<usuario>:<contraseña>@<host>:<puerto>/<database>?schema=public"

# JWT Secret - Cambia esto en producción
JWT_SECRET="clave_super_segura_cambiar_en_produccion"

# Puerto (Railway asigna automáticamente)
PORT=3000

# URL del Frontend (para CORS)
FRONTEND_URL="http://localhost:5173"

# Seguridad de autenticación
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_ATTEMPT_WINDOW_MINUTES=15
AUTH_LOCKOUT_MINUTES=30

# OpenAI API Key para reconocimiento de imágenes
OPENAI_API_KEY="tu-api-key-de-openai"

# Entorno
NODE_ENV="production"
