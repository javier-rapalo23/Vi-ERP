generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
// Users
model User {
  id                     Int                    @id @default(autoincrement())
  name                   String
  email                  String                 @unique
  password               String
  role                   String
  isActive               Boolean                @default(true)
  createdAt              DateTime               @default(now())
  createdBy              Int?
  updatedBy              Int?
  updatedAt              DateTime               @updatedAt
  sessions               session[]
  userRoles              UserRole[]
  shifts                 Shift[]
  auditLogs              AuditLog[]
  loginAttempts          LoginAttempt[]
  inventoryTransactions  InventoryTransaction[]
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String?
  isActive        Boolean          @default(true)
  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model UserRole {
  id     Int @id @default(autoincrement())
  userId Int
  roleId Int
  user   User @relation(fields: [userId], references: [id])
  role   Role @relation(fields: [roleId], references: [id])
}
model Permission {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String?
  rolePermissions RolePermission[]
}
model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
}

model session {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}

// Inventory
model Product {
  id                    Int                    @id @default(autoincrement())
  name                  String
  code                  String                 @unique
  barcode               String?                @unique
  price                 Float
  cost                  Float
  stock                 Int                    @default(0)
  minStock              Int                    @default(0)
  lastSaleDate          DateTime?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  saleDetails           SaleDetail[]
  purchaseDetails       PurchaseDetail[]
  inventoryTransactions InventoryTransaction[]
}

// Sales
model Customer {
  id    Int     @id @default(autoincrement())
  name  String
  phone String?
  email String?
  adress String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  createdBy Int?
  updatedBy Int?
  updatedAt DateTime @updatedAt
  sales Sale[]
}

model Sale {
  id                 Int                 @id @default(autoincrement())
  invoiceNumber      String              @unique
  invoiceSnapshot    Json?
  customerId         Int
  shiftId            Int?
  paymentMethod      PaymentMethod       @default(CASH)
  total              Float
  status             SaleStatus          @default(PENDING)
  date               DateTime            @default(now())
  dueDate            DateTime?
  customer           Customer            @relation(fields: [customerId], references: [id])
  shift              Shift?              @relation(fields: [shiftId], references: [id])
  details            SaleDetail[]
  accountsReceivable AccountsReceivable?
}

model SaleDetail {
  id        Int     @id @default(autoincrement())
  saleId    Int
  productId Int
  quantity  Int
  unitPrice Float
  sale      Sale    @relation(fields: [saleId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model AccountsReceivable {
  id          Int               @id @default(autoincrement())
  saleId      Int               @unique
  totalAmount Float
  paidAmount  Float             @default(0)
  balance     Float
  dueDate     DateTime?
  sale        Sale              @relation(fields: [saleId], references: [id])
  payments    CustomerPayment[]
}

model CustomerPayment {
  id                   Int                @id @default(autoincrement())
  accountsReceivableId Int
  amount               Float
  paymentMethod        String
  reference            String?
  date                 DateTime           @default(now())
  accountsReceivable   AccountsReceivable @relation(fields: [accountsReceivableId], references: [id])
}

model InventoryTransaction {
  id            Int      @id @default(autoincrement())
  productId     Int
  quantity      Int
  type          String   // "IN" for purchases, "OUT" for sales, "ADJ" for adjustments
  reference     String   @default("MANUAL") // "SALE", "PURCHASE", "ADJUSTMENT", "TRANSFER"
  referenceId   Int?     // Foreign key to Sale, Purchase, etc.
  userId        Int?     // User who made the transaction
  costPerUnit   Float    @default(0) // Cost/selling price per unit at time of transaction
  description   String?  // Additional notes
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id])
  user          User?    @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([date])
  @@index([reference])
  @@index([productId, date])
}



//Compras
model Supplier {
  id    Int     @id @default(autoincrement())
  name  String
  phone String?
  email String?
  adress String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  createdBy Int?
  updatedBy Int?
  updatedAt DateTime @updatedAt
  purchases Purchase[]
}

model Purchase {
  id              Int              @id @default(autoincrement())
  supplierId      Int
  total           Float
  status          PurchaseStatus   @default(PENDING)
  date            DateTime         @default(now())
  dueDate         DateTime
  supplier        Supplier         @relation(fields: [supplierId], references: [id])
  details         PurchaseDetail[]
  accountsPayable AccountsPayable?
}

model PurchaseDetail {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  productId  Int
  quantity   Int
  unitPrice  Float
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
}

model AccountsPayable {
  id          Int       @id @default(autoincrement())
  purchaseId  Int       @unique
  totalAmount Float
  paidAmount  Float     @default(0)
  balance     Float
  dueDate     DateTime
  purchase    Purchase  @relation(fields: [purchaseId], references: [id])
  payments    Payment[]
}

model Payment {
  id                Int             @id @default(autoincrement())
  accountsPayableId Int
  amount            Float
  paymentMethod     String
  reference         String?
  date              DateTime        @default(now())
  accountsPayable   AccountsPayable @relation(fields: [accountsPayableId], references: [id])
}

enum PurchaseStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum SaleStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
}

enum ShiftStatus {
  OPEN
  CLOSED
}

// Cash Register Shifts
model Shift {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           User      @relation(fields: [userId], references: [id])
  openingAmount  Float
  closingAmount  Float?
  expectedAmount Float?    // calculated: openingAmount + total sales
  variance       Float?    // calculated: closingAmount - expectedAmount
  status         ShiftStatus @default(OPEN)
  notes          String?
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  sales          Sale[]
}

// Configuración del sistema
model Setting {
  id          Int      @id @default(autoincrement())
  key         String   @unique  // Clave única: CURRENCY_NAME, CURRENCY_SYMBOL, TAX_RATE, etc.
  name        String            // Nombre legible: "Moneda", "Símbolo", "Impuesto ISV", etc.
  value       String            // Valor: "Lempira", "L.", "15", etc.
  description String?           // Descripción opcional del parámetro
  group       String?           // Agrupación: "MONEDA", "IMPUESTO", "EMPRESA", "FACTURA"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  module    String
  action    String
  entity    String
  entityId  Int?
  oldValues Json?
  newValues Json?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model LoginAttempt {
  id          Int      @id @default(autoincrement())
  userId      Int?
  email       String
  ipAddress   String?
  success     Boolean
  blockedUntil DateTime?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}
